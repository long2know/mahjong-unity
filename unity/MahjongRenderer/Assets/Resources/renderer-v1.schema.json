      "allOf": [
        {
          "if": {
            "properties": {
              "knownFace": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "faceIndex": {
                "const": null
              },
              "showFace": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "knownFace": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "faceIndex": {
                "type": "integer",
